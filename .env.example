# ==============================================================================
# Fact Knowledge Layer - Environment Configuration Template
# Copy this file to .env and fill in your configuration values.
# ==============================================================================

# Google Gemini API Key (Required when enabling LLM Fact Extraction and Reasoning)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database storage path (relative to project root or absolute path)
DATABASE_PATH=data/fact_knowledge.db

# Directory for storing uploaded PDF files
UPLOAD_DIR=data/uploads
